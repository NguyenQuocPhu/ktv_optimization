# Cấu hình Kafka cho ktv_worker (core/build/ktv_worker).
# Copy file này thành .env rồi điền — .env không được commit (đã có trong .gitignore).
# Giá trị trong .env bị biến môi trường thật đè lên khi chạy.


KAFKA_BOOTSTRAP_SERVERS=

# Quy ước công ty: true = tự bật SASL theo transport (PLAINTEXT → SASL_PLAINTEXT, SSL → SASL_SSL).
# Để trống = dùng nguyên KAFKA_SECURITY_PROTOCOL bên dưới. Kafka local (không SASL): đặt false.
KAFKA_USE_SASL=true

# SASL_PLAINTEXT cho queue cluster: PLAIN hoặc SCRAM-SHA-512 tuỳ tài khoản
# (dev queue hiện tại phải dùng SCRAM-SHA-512; PLAIN bị trả invalid credentials).
# Kafka local: PLAINTEXT và bỏ trống user/pass.
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

KAFKA_CLIENT_ID=ktv-core-ai

# Consumer group — xin quy ước từ SYS trước khi chạy. Khác KAFKA_CLIENT_ID.
# Chạy thử thì dùng group riêng, ví dụ ktv-core-test.
KAFKA_GROUP_ID=

# Topic IN: event "task đã gán cho KTV" do Optimal Assign phát.
KAFKA_TOPIC_IN=stag-inside-par-assignment-optimal-assign-task-emp-assigned-queue

# Topic OUT: route trả ra — chờ SYS cấp tên + quyền WRITE. Bước produce OUT làm sau.
KAFKA_TOPIC_OUT=

# earliest: đọc từ đầu topic (chạy thử) | latest: chỉ đọc message mới.
KAFKA_AUTO_OFFSET_RESET=earliest
